{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshare",
  "version": "0.11.3",
  "identifier": "com.rafaelrain.screenshare",
  "build": {
    "beforeDevCommand": "node scripts/build-frontend.mjs --dev",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "devUrl": "http://localhost:8081/?serverUrl=ws%3A%2F%2Flocalhost%3A8080",
    "frontendDist": "../../client/build/dist/js/productionExecutable"
  },
  "app": {
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:8080 wss://screen-share.fly.dev https://fonts.googleapis.com https://fonts.gstatic.com",
        "font-src": "'self' https://fonts.gstatic.com data:",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Screenshare",
        "url": "index.html?serverUrl=wss%3A%2F%2Fscreen-share.fly.dev",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0c11",
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QjA2QTc5NTNBMjE1NzEKUldSeEZhSlRlV3F3R1NXWXE3dXVGUUhXMURwNEpqWEtrYXpNS1pQV3hGc3F5TzM3bzljUk9mZFkK",
      "endpoints": [
        "https://github.com/RafaelrainBR/screenshare-kotlin-js/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "P2P screen sharing using the canonical Kotlin client",
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
